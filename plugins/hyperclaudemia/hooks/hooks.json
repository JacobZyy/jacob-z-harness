{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/setup.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bun run --bun ${CLAUDE_PLUGIN_ROOT}/scripts/lint-strategy-warmup.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "HYPERCLAUDEMIA_HOOK_EVENT=PreToolUse bun run --bun ${CLAUDE_PLUGIN_ROOT}/scripts/zzcommon-apply-patch-hook.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "HYPERCLAUDEMIA_HOOK_EVENT=PostToolUse bun run --bun ${CLAUDE_PLUGIN_ROOT}/scripts/zzcommon-apply-patch-hook.ts",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun run --bun ${CLAUDE_PLUGIN_ROOT}/scripts/lint-fix-stop.ts",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bun run --bun ${CLAUDE_PLUGIN_ROOT}/scripts/complexity-stop.ts",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bun run --bun ${CLAUDE_PLUGIN_ROOT}/scripts/token-stats-stop.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
